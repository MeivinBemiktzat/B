<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>EscapeSpaceStation</RootNamespace>
    <AssemblyName>EscapeSpaceStation</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Icon.ico</ApplicationIcon>

    <!-- Windows-only build -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!--
      NOTE: PublishSingleFile is intentionally NOT used here.
      MonoGame.Framework.DesktopGL depends on native libraries (SDL2.dll,
      soft_oal.dll, etc.) that must sit as real files next to the .exe at
      startup. Single-file self-extraction is unreliable for these native
      dependencies in practice (causes "Failed to load library: SDL2.dll"
      crashes on some machines). Publishing as a self-contained folder
      keeps every native DLL alongside the exe and is 100% portable: no
      installer, no .NET Runtime required on the target machine - just
      copy the folder and run EscapeSpaceStation.exe.
    -->

    <!-- MonoGame content pipeline needs this -->
    <MonoGameContentBuilderExe>mgcb</MonoGameContentBuilderExe>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy raw images/audio next to the exe so they can be loaded at runtime
         with graceful fallback if missing (see Systems/AssetManager.cs) -->
    <None Include="Content\Images\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Content\Images\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="Content\Audio\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Content\Audio\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
